# WorkBuddy Manager 环境变量示例
# 复制为 .env 并按需修改（systemd 部署时写在 unit 文件里更直观）

# ── 本服务 ──────────────────────────────────────────────
# 监听地址。默认 127.0.0.1：公网访问一律经反向代理（HTTPS 加访问控制），
# 直接暴露管理面是被打穿的常见入口。确需局域网直连才改成 0.0.0.0，并自担风险。
WB_MANAGER_HOST=127.0.0.1
WB_MANAGER_PORT=7864
# auto = 依据 X-Forwarded-Proto 自动判断；生产走 HTTPS 时保持 auto 或设为 true。
# 反代若未透传该头，auto 会静默地不加 Secure（登录日志里有告警）——确定只走
# HTTPS 时建议直接写 true，不必依赖反代是否传头。
WB_SECURE_COOKIE=auto
# 会话总时长上限（天）：登录后最多维持这么久，到点必须重新登录。
WB_SESSION_DAYS=1
# 会话空闲上限（小时）：多久没操作就失效（**滑动续期**窗口）。常用的人会自动
# 续期、不被打扰；放着不用的会话到点自己过期。**0 = 关闭空闲判定**，只按上面的
# 总时长失效（注意：关闭后升级前签发的旧 cookie 也能继续用到总时长为止）。
WB_SESSION_IDLE_HOURS=12
# 允许跨域来源（同源部署留空）
WB_CORS_ORIGINS=

# ── 上游 workbuddy2api（Go 反代）────────────────────────
WB2API_BASE=http://127.0.0.1:7863
# 留空则自动读取 /opt/workbuddy2api/config.json 中的 api_key
WB2API_KEY=
# docker（默认）或 native（Windows/宿主机原生进程）
WB2API_MODE=docker
WB2API_CONTAINER=workbuddy2api

# ── 上游数据文件（与 workbuddy2api 共享）────────────────
WB_AUTH_DIR=/opt/workbuddy2api/auths
WB_UPSTREAM_CONFIG=/opt/workbuddy2api/config.json
# 上游仓库目录：留空则按 config.json 所在目录推断。任务脚本、上游更新与
# native 启停脚本都以它为准（全项目只有这一处口径，改这里就够）
WB_UPSTREAM_DIR=/opt/workbuddy2api
# native 模式使用；Windows 路径可写成 C:/path/to/file.cmd
WB2API_START_SCRIPT=/opt/workbuddy2api/start-workbuddy2api.cmd
WB2API_STOP_SCRIPT=/opt/workbuddy2api/stop-workbuddy2api.cmd
WB2API_LOG_FILE=/opt/workbuddy2api/data/server.err.log

# ── 本管理端数据 ────────────────────────────────────────
WB_DATA_DIR=/opt/workbuddy-manager/data
WB_DB=/opt/workbuddy-manager/data/manager.db
WB_USERS_FILE=/opt/workbuddy-manager/data/users.json
WB_STATIC_DIR=/opt/workbuddy-manager/web/out

# ── 一键更新的下载代理（可选，issue #106）────────────────
# 容器里能连上 api.github.com（版本检测走它）却连不上 Release 资产所在的
# github.com / objects.githubusercontent.com 时，更新会一直失败并报
# 「timed out / Remote end closed」。给更新器指定代理即可：
#   WB_UPDATE_PROXY=http://172.17.0.1:7890
# 留空 = 沿用 WB_HTTP_PROXY（面板的出口代理）；两者都留空时再沿用容器环境变量里
# 的 http_proxy / https_proxy。本机与 127.0.0.1 / localhost 会自动绕过代理。
WB_UPDATE_PROXY=

# ── 容器内操作 docker 的组 GID（容器部署，可选）─────────────
# 容器以 uid 10001 运行，而宿主的 /var/run/docker.sock 通常归 root:docker
# （GID 998/999）—— 不在那个组里，「一键更新」重建上游容器就会 permission denied。
# 取本机真实值填进来（docker-compose.yml 里以 group_add 生效）：
#   DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
# 留空 = 用 compose 里的默认 999（Debian/Ubuntu 上最常见）。填错不会静默失败：
# 更新上游时会提示你去取真实 GID。不需要容器内操作 docker 的话留空即可。
DOCKER_GID=

# ── 子路径部署（可选）───────────────────────────────────
# 把管理端挂在域名子路径下时填写，例如 https://example.com/workbuddy-manager/
# 留空 = 根路径部署（默认）。必须与前端构建时的 NEXT_PUBLIC_BASE_PATH 一致，
# 否则 RSC 兜底重定向会把用户送到域名根路径。反代配置见 deploy/README.md。
WB_BASE_PATH=
# 前端构建期变量（不在 .env 里生效，需在构建命令前指定）：
#   NEXT_PUBLIC_BASE_PATH=/workbuddy-manager npm run build:export

# ── 本机一键导入（可选，默认关闭）───────────────────────
# 允许面板把**刚创建的密钥**直接写进本机的 cc-switch / ZCode 配置
# （「密钥」页「一次性展示新密钥」弹窗里的「导入」按钮）。
# 只在面板与客户端**同一台机器**时才有意义。
#
# 默认关闭：这是本面板唯一会写用户桌面应用数据的动作。开启后仍有两道保护——
#   1. 只接受**回环来源**（用 127.0.0.1 打开面板）；局域网/远程访问一律拒绝，
#      因为那只会写到服务器上的 ~/.cc-switch，对你本机毫无影响。
#   2. 客户端**正在运行**时分两种走法（见下「导入的两条路径」）：cc-switch 优先
#      走它自己的官方深链（不用关它）；走文件直写时会先把它关掉、写完再拉起来。
# 每次写入前都会在目标文件同目录留一份 `*.wbimport-<时间戳>.bak` 备份。
WB_LOCAL_IMPORT=0
# 客户端数据目录（仅非默认安装位置时需要改；不填则用 ~/.cc-switch 与 ~/.zcode/v2）
# WB_CCSWITCH_DIR=C:/Users/me/.cc-switch
# WB_ZCODE_DIR=C:/Users/me/.zcode/v2

# ── 客户端自动检测与自动拉起（通常不用配）─────────────────
# 面板会自己找客户端可执行文件：环境变量 → 运行中的进程 → 协议注册表
# （HKCU\Software\Classes\ccswitch|zcode）→ 上次缓存 → 常见安装位 → 受限扫描。
# 正常安装的机器**一个都不用填**。下面四个是逃生舱，只在检测不到时才需要：
#
# 1) 直接指定 exe（最强，跳过全部探测）
# WB_CCSWITCH_EXE=E:/cc swich/cc-switch.exe
# WB_ZCODE_EXE=E:/zcode/ZCode.exe
#
# 2) 只指定扫描起点（默认扫所有固定盘的用户目录，深度 3，预算 4000 目录 / 6 秒）
# WB_CLIENT_SCAN_ROOTS=D:/apps;E:/tools
#
# 3) 检测结果缓存文件（默认在 data/ 下，一般无需改）
# WB_CLIENT_PATHS_FILE=C:/Users/me/workbuddy-manager/data/client_paths.json

# ── 初始管理员（仅首次启动生效）─────────────────────────
# 留空则随机生成并打印到日志
WB_ADMIN_PASSWORD=

# ── 对外网关（/v1 反代）─────────────────────────────────
# 每密钥限流：60 秒内**放行**的请求数上限（0 = 不限制）。超出的返回 429，
# 且**不占用额度**——客户端把速率降到阈值以下立刻恢复。
WB_GATEWAY_RATE_PER_MIN=120
# 请求体上限（MB）。上游自 2026-09-13 起不再限制大小，这是本端自己的保护。
WB_GATEWAY_MAX_BODY_MB=32

# ── 一键更新 ────────────────────────────────────────────
# 更新管理端时是否让 deploy/ 一起更新（默认 1）。deploy/ 里是更新器本身与验签
# 逻辑：发布包在解压前已验签，所以更新它不会削弱那道防线；而不更新就意味着以后
# 每次更新都还用旧更新器（它修过的毛病不会生效）。
# 只有你在手工维护 deploy/（例如改过 systemd 单元）时才设为 0。
WB_SYNC_DEPLOY=1

# ── 网络 ────────────────────────────────────────────────
# 本文件（复制成 .env 后）三种部署都会读：容器部署由 compose 取下面的出口代理等几个
# 变量、systemd 部署由单元里的 EnvironmentFile 读整个文件、Windows 原生由启动脚本
# 传给面板。改动后重启服务生效。
WB_UPSTREAM_TIMEOUT=120
WB_TENCENT_TIMEOUT=15
WB_TRUST_PROXY=1
# 可信反向代理网段（逗号分隔）。只有**TCP 对端**落在这些网段里时，才采信
# X-Real-IP / X-Forwarded-For。默认只有回环 —— 反代与面板同机时不用改；
# 反代在另一台机器（或 CDN 回源）时，把那台的网段加进来，例如：
#   WB_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,192.168.1.0/24
# 不要写成 0.0.0.0/0：那等于把来源 IP 交给任何客户端伪造。
# WB_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# 批量出站请求的并发上限（都是可选，调大更快、但更接近腾讯风控的阈值）：
#   · WB_CREDITS_CONCURRENCY  刷新积分时同时查几个号（默认 8）
#   · WB_CHECKIN_CONCURRENCY  全部签到时同时签几个号（默认 5）
#   · WB_REFRESH_CONCURRENCY  一键刷新令牌时同时刷几个号（默认 3，最敏感）
# 账号很多（比如 100+）时，刷积分曾经会把面板自己的连接池占满，连累单号测活
# 报「PoolTimeout」——那里已经限流并给交互操作分了独立连接池（issue #161），
# 所以一般不需要动这几项。
WB_CREDITS_CONCURRENCY=8
# 出口代理（可选）。留空 = 所有请求都不走代理（内网/本机目标本来就直连）。
# 支持 http:// / https:// / socks5://（socks5 依赖 requirements 里的 socksio）。
# 内网与本机目标（127.0.0.1、私有网段、workbuddy2api / host.docker.internal 这类
# 内网名）**不受它影响、始终直连** —— 所以配了代理也不会把「面板 → 上游」那一跳
# 交给代理。若服务器上装了代理软件（Clash 等 TUN 模式）且它劫持了本机流量，
# 那属于系统层面的问题，仍建议把 127.0.0.1 加进它的直连名单。
# 另外：一键更新的下载只认 http/https，配了 socks5 时更新器会忽略它并提示
# （需要更新也走代理请单独设 WB_UPDATE_PROXY=http://…）。
WB_HTTP_PROXY=

# 新账号默认绑定的命名出口线路；空值沿用既有出口。
# 名称必须存在于 WB_UPSTREAM_CONFIG 的 proxies 映射。
WB_DEFAULT_ACCOUNT_PROXY=

# GitHub Token：版本检测与「一键更新」调 GitHub API 的认证（issue #205）。
# 不设 = 未认证，60 次/小时/IP；出口走共享代理时很容易被同出口的人打满，
# 表现是「检测更新」失败（HTTP 403）。设了 = 5000 次/小时。
# 只需要「读公共仓库的 Releases」权限（fine-grained token 勾 Public repositories (read-only) 即可）。
# 面板「设置 → 系统」里也能填同一项：环境变量优先于面板里填的那份。
WB_GITHUB_TOKEN=

# GitHub 镜像加速（可选，issue #216）。国内机器直连 github.com / api.github.com
# 经常超时，表现为「检测更新」失败、发布包下载卡在 0%。填一个加速服务的基址即可：
#   WB_GITHUB_MIRROR=https://gh-proxy.com/
# 用法是「基址 + 完整原始地址」（如 https://gh-proxy.com/https://github.com/...），
# 本程序会自动拼接；版本检测与发布包下载都先走镜像，失败自动回退直连。
# 注意：镜像会把请求转给第三方，因此**走镜像时不会发送 WB_GITHUB_TOKEN**；
# 下载公开仓库的 Release 本身不需要认证。
# 面板「设置 → 系统」里也能填同一项：面板里填的优先于这里。
WB_GITHUB_MIRROR=

# 一键更新时，若本次发布包含上游源码变化，默认会一并同步并重建上游容器（issue #217）。
# 自己改过上游目录、不想被发布包覆盖时设 0：只更新面板，上游保持现状。
WB_SYNC_UPSTREAM=
