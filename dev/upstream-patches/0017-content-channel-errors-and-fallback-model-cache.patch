+func TestContentRejectionWithGenericChannelTipsStaysRequestLevel(t *testing.T) {
+	for _, message := range []string{"Illegal API invocation from an unapproved channel", "blocked by security policy"} {
+		body := `{"code":11128,"msg":"` + message + `","displayTips":{"en":"This call failed channel verification, possibly because it was not sent from an official client."}}`
+		if IsChannelCheck(body) {
+			t.Fatalf("generic displayTips overrode content rejection: %s", body)
+		}
+		if got := Classify(400, body); got != ErrContentBlocked {
+			t.Fatalf("content rejection must not cool accounts: got %v", got)
+		}
+	}
+}
