+package upstream
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"workbuddy2api/internal/auth"
+)
+
+func TestConsoleMissingModelPreservesPrimaryRejection(t *testing.T) {
+	paths := []string{}
+	c := testClient(func(r *http.Request) (*http.Response, error) {
+		paths = append(paths, r.URL.Path)
+		if r.URL.Path == chatCompletionsPath {
+			r := jsonResp(400, channelBody)
+			r.Header.Set("Retry-After", "30")
+			return r, nil
+		}
+		return jsonResp(400, `{"code":11102,"msg":"model [deepseek-v4.1-flash] service info not found"}`), nil
+	})
+	_, status, body, err := c.ChatStream(&auth.Auth{UID: "u1"}, []byte(`{"model":"deepseek-v4.1-flash","messages":[]}`), "", ChatMeta{})
+	if len(paths) != 2 || status != 400 || string(body) != channelBody {
+		t.Fatalf("lost primary response: paths=%v status=%d body=%s", paths, status, body)
+	}
+	ue, ok := err.(*Error)
+	if !ok || ue.Kind != ErrAccountFault || ue.RetryAfter != 30*time.Second {
+		t.Fatalf("fallback must not produce model-blocked policy: %v", err)
+	}
+}
+
+func TestPrimaryMissingModelStillReturnsModelBlocked(t *testing.T) {
+	calls := 0
+	c := testClient(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return jsonResp(400, `{"code":11102,"msg":"model service info not found"}`), nil
+	})
+	_, _, _, err := c.ChatStream(&auth.Auth{UID: "u1"}, []byte(`{"model":"missing","messages":[]}`), "", ChatMeta{})
+	ue, ok := err.(*Error)
+	if !ok || ue.Kind != ErrModelBlocked || calls != 1 {
+		t.Fatalf("real primary missing-model behavior changed: calls=%d err=%v", calls, err)
+	}
+}
+
+func TestConsoleFallbackCanStillSucceed(t *testing.T) {
+	c := testClient(func(r *http.Request) (*http.Response, error) {
+		if r.URL.Path == chatCompletionsPath {
+			return jsonResp(400, channelBody), nil
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("data: [DONE]\n\n"))}, nil
+	})
+	rc, status, _, err := c.ChatStream(&auth.Auth{UID: "u1"}, []byte(`{"model":"supported","messages":[]}`), "", ChatMeta{})
+	if err != nil || status != 200 || rc == nil {
+		t.Fatalf("successful fallback changed: status=%d err=%v", status, err)
+	}
+	rc.Close()
+}
