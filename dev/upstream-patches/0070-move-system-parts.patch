+// TestMoveSystemToUserSupportsSystemContentParts system 侧也可能是 parts 数组：
+// 只取 text part 拼接，不能让整次抢救因类型断言失败而放弃。
+func TestMoveSystemToUserSupportsSystemContentParts(t *testing.T) {
+	body := []byte(`{"messages":[` +
+		`{"role":"system","content":[{"type":"text","text":"PERSONA-A"},` +
+		`{"type":"image_url","image_url":{"url":"x"}}]},` +
+		`{"role":"user","content":"hello"}]}`)
+	out, ok := MoveSystemToUser(body)
+	if !ok {
+		t.Fatal("system content parts 数组也应能搬运")
+	}
+	var req struct {
+		Messages []struct {
+			Role    string `json:"role"`
+			Content any    `json:"content"`
+		} `json:"messages"`
+	}
+	if err := json.Unmarshal(out, &req); err != nil {
+		t.Fatalf("输出不是合法 JSON: %v", err)
+	}
+	if req.Messages[0].Role != "system" || req.Messages[0].Content != Degraded {
+		t.Fatalf("首条应换成中性提示词，got %+v", req.Messages[0])
+	}
+	if s, _ := req.Messages[1].Content.(string); !strings.Contains(s, "PERSONA-A") ||
+		!strings.HasSuffix(s, "hello") {
+		t.Fatalf("system text part 应搬到 user 前部，got %q", req.Messages[1].Content)
+	}
+}
