+++ b/internal/upstream/session_dead_401_test.go
@@ -0,0 +1,79 @@
+package upstream
+
+import (
+	"net/http"
+	"testing"
+)
+
+// 401 一律归「登录态失效」（需要重新登录的终态）。
+//
+// 背景：APISIX/openresty 对吊销凭证直接回 HTML 401（body 里没有 code 字段），
+// 旧逻辑落通用 ErrClient「只换号不罚号」——账号留在池里被反复选中、每次白换
+// 一次号，/status 仍显示健康，面板刷新积分只会静默回退到上游快照。
+func TestClassify401AsSessionDead(t *testing.T) {
+	cases := []struct {
+		name   string
+		status int
+		body   string
+		want   ErrKind
+	}{
+		{
+			name:   "APISIX HTML 401（无业务信封）",
+			status: http.StatusUnauthorized,
+			body:   "<html>\n<head><title>401 Authorization Required</title></head>\n<body><center><h1>401 Authorization Required</h1></center><hr><center>openresty</center></body>\n</html>",
+			want:   ErrSessionDead,
+		},
+		{
+			name:   "空 body 401",
+			status: http.StatusUnauthorized,
+			body:   "",
+			want:   ErrSessionDead,
+		},
+		{
+			name:   "12153 业务信封（原有路径不变）",
+			status: http.StatusUnauthorized,
+			body:   `{"code":12153,"msg":"12153:refresh token is invalid","requestId":"x"}`,
+			want:   ErrSessionDead,
+		},
+		{
+			// 带 JSON 业务信封的 401 保持既有语义（业务层答复，交由各层判定），
+			// 不能因为状态码是 401 就一刀切改判——既有的 TestClassify 也锁着这条。
+			name:   "JSON 401 无 12153（保持 ErrClient）",
+			status: http.StatusUnauthorized,
+			body:   `{"code":401,"msg":"unauthorized"}`,
+			want:   ErrClient,
+		},
+		{
+			name:   "403 HTML 仍是 WAF（语义不能被 401 规则带偏）",
+			status: http.StatusForbidden,
+			body:   "<html><head><title>403 Forbidden</title></head></html>",
+			want:   ErrWafBlock,
+		},
+		{
+			name:   "400 HTML 仍是客户端错误",
+			status: http.StatusBadRequest,
+			body:   "<html><body>bad request</body></html>",
+			want:   ErrClient,
+		},
+		{
+			name:   "200 业务信封不受影响",
+			status: http.StatusOK,
+			body:   `{"code":0,"msg":"OK"}`,
+			want:   ErrNone,
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := Classify(c.status, c.body); got != c.want {
+				t.Fatalf("Classify(%d, %q) = %v, want %v", c.status, shortBody(c.body), got, c.want)
+			}
+		})
+	}
+}
+
+func shortBody(s string) string {
+	if len(s) <= 40 {
+		return s
+	}
+	return s[:40] + "..."
+}
