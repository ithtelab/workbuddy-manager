+def build_skill_share_channel_body(skill):
+    """构造 Open Platform 创建分享渠道的请求体（纯函数，单测钉字段形状）。
+
+    asset_ref 必须是 JSON **字符串**且键名是 asset_id（snake_case）——对象形式
+    或 assetId 会被上游拒为「请求参数不合法」。
+    """
+    sid = str(skill.get("id") or "").strip()
+    return {
+        "asset_kind": "skill",
+        "asset_source": "market",
+        "asset_ref": json.dumps({"asset_id": sid}, separators=(",", ":")),
+        "ways": ["link", "wxacode", "wxapath"],
+        "extra": {
+            "name": skill.get("name") or "技能",
+            "description": skill.get("description") or "",
+            "shareKey": sid,
+            "marketplaceSource": "builtin-market",
+        },
+    }
