+def _create_skill_share_channel(auth, skill):
+    """创建真实技能分享渠道；返回 {ok, channel_id, share_code, ...}。"""
+    body = build_skill_share_channel_body(skill)
+    headers = {
+        "Accept": "application/json, text/plain, */*",
+        "User-Agent": DESKTOP_UA,
+        "X-User-Id": auth["uid"],
+        "X-Domain": tc.chat_base(auth),
+        "X-Product": "SaaS",
+        # tc._headers 默认带 codebuddy 的 Origin/Referer；分享接口在 open 域，
+        # 覆盖成同域，避免跨域来源被判异常。
+        "Origin": SKILL_SHARE_BASE,
+        "Referer": SKILL_SHARE_BASE + "/",
+    }
+    try:
+        st, r = tc.do_post(auth, SKILL_SHARE_BASE, SKILL_SHARE_CHANNEL_PATH, body,
+                           headers=headers)
+    except Exception as ex:
+        return {"ok": False, "status": -1, "msg": repr(ex)[:160]}
+    code = r.get("code") if isinstance(r, dict) else None
+    if st != 200 or code not in (0, 200, "0", "200"):
+        msg = r.get("msg") if isinstance(r, dict) else ""
+        return {"ok": False, "status": st, "code": code, "msg": str(msg or "")[:160]}
+    data = r.get("data") or {}
+    channel_id = str(data.get("channel_id") or "").strip()
+    share_code = str(data.get("share_code") or "").strip()
+    link = ""
+    for way in data.get("ways") or []:
+        if isinstance(way, dict) and way.get("share_way") == "link":
+            link = str(way.get("resource_ref") or "").strip()
+            break
+    if not channel_id or not share_code or not link:
+        return {"ok": False, "status": st, "code": code,
+                "msg": "分享接口缺少 channel_id/share_code/link"}
+    return {"ok": True, "channel_id": channel_id, "share_code": share_code}
