+def desktop_expert_summon_sequence(expert):
+    """召唤三连（对齐参考实现 DesktopExpertSummonSequence 的抓包形状）。"""
+    eid, m = expert
+    cat = m.get("category") or "expert-all"
+    ver = m.get("version") or "1.0.0"
+    name = m.get("name") or eid
+    return [
+        {"eventCode": "web_element_click", "source": eid, "type": cat,
+         "version": ver, "elementId": "expert_summon_click",
+         "elementName": "立即召唤",
+         "pageURL": "/C:/Program%20Files/WorkBuddy/resources/app.asar/renderer/index.html"},
+        {"eventCode": "expert_summon_click", "id": eid, "name": name,
+         "expertTitle": name, "type": "expert-all", "position": 0,
+         "expertType": m.get("expertType") or "agent", "version": ver,
+         "mode": "LOCAL"},
+        {"eventCode": "expert_summoned", "id": eid, "name": name,
+         "expertTitle": name, "type": "expert-all"},
+    ]
+
+
+def desktop_expert_actual_use_local(expert, conversation_id, request_id):
+    """mode=LOCAL 的 expert_actual_use（轻量云判据：type 为空、cost=0）。"""
+    eid, m = expert
+    name = m.get("name") or eid
+    return {
+        "eventCode": "expert_actual_use", "mode": "LOCAL", "id": eid,
+        "name": name, "expertTitle": name, "type": "",
+        "expertType": m.get("expertType") or "agent", "source": "builtin",
+        "version": m.get("version") or "1.0.0", "cost": 0, "characterCount": 14,
+        "conversationId": conversation_id, "requestId": request_id,
+        "messageId": "msg-" + request_id[-8:],
+        "requestModelId": "fast-model", "requestModelName": "fast-model",
+    }
+
+
