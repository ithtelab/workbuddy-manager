+# ── Expert_lighthouse：真实对话链（issue #221）───────────────────────────
+# 服务端对这条任务的判据与 expert_5 不同：需要「召唤三连 + 带 has_expert 的
+# 桌面对话六连 + expert_actual_use」，且 actual_use 的 requestId 必须是 chat
+# 接口返回的服务端 id（cmb-… / 32 位 hex）。自造 UUID 上报 200 但不计数，
+# 于是进度永远停在 0/1。下面的实现对齐参考实现 autotask.go/desktop.go。
+_LIGHTHOUSE_ID_RE = re.compile(r"^(cmb-)?[0-9a-f]{32}$")
+
+
+def _lighthouse_real_chat(auth, expert_id):
+    """发一次真实桌面对话，返回 (conversation_id, server_request_id, error)。
+
+    只负责建立对话并取服务端 requestId；失败时返回可读原因，由调用方跳过本轮，
+    不退回自造 UUID（那正是这条任务一直 0/1 的原因）。
+    """
+    now_ns = time.time_ns()
+    conv = f"wb2api-conv-{now_ns}"
+    body = {
+        "model": "fast-model",
+        "messages": [
+            {"role": "system",
+             "content": "You are a helpful assistant. 当前处于中文环境，使用简体中文回答。"},
+            {"role": "user", "content": "1+1等于几？直接回答。"},
+        ],
+        "agent": "cli", "temperature": 1, "stream": True,
+        "stream_options": {"include_usage": True},
+    }
+    headers = tc._headers(auth)
+    headers.update({
+        "Accept": "text/event-stream", "User-Agent": DESKTOP_UA,
+        "X-Domain": tc.chat_base(auth), "X-Product": "SaaS",
+        "X-User-Id": auth["uid"], "X-Conversation-ID": conv,
+        "X-Request-ID": str(now_ns), "X-Agent-Intent": "craft",
+        "X-Agent-Type": "main", "X-IDE-Name": "WorkBuddy",
+        "X-IDE-Type": "WorkBuddy", "X-IDE-Version": "5.5.6",
+        "x-codebuddy-request": "1", "X-Expert-Id": expert_id,
+    })
+    req = urllib.request.Request(
+        tc.chat_base(auth) + tc.PATH_CHAT,
+        data=json.dumps(body).encode(), headers=headers, method="POST")
+    try:
+        with urllib.request.urlopen(req, timeout=90) as resp:
+            if resp.status != 200:
+                return conv, "", f"chat http {resp.status}"
+            for raw in resp:
+                line = raw.decode("utf-8", "replace")
+                if not line.startswith("data: "):
+                    continue
+                payload = line[6:].strip()
+                if not payload or payload == "[DONE]":
+                    continue
+                try:
+                    obj = json.loads(payload)
+                except Exception:
+                    continue
+                rid = obj.get("id") if isinstance(obj, dict) else None
+                if isinstance(rid, str) and _LIGHTHOUSE_ID_RE.match(rid):
+                    return conv, rid, ""
+            return conv, "", "SSE 中未找到服务端 requestId"
+    except urllib.error.HTTPError as exc:
+        return conv, "", f"chat http {exc.code}"
+    except Exception as exc:  # noqa: BLE001 —— 网络/解析失败统一交给调用方记日志
+        return conv, "", repr(exc)[:200]
+
