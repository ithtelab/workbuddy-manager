diff --git a/cmd/server/proxies_json.go b/cmd/server/proxies_json.go
new file mode 100644
index 0000000..167b4fb
--- /dev/null
+++ b/cmd/server/proxies_json.go
@@ -0,0 +1,42 @@
+package main
+
+// 线路表的 JSON 兼容：值可以是地址字符串，也可以是面板「设置 → 代理」写出的
+// {url, weight, enabled} 对象（issue #379）。
+//
+// 面板侧的 weight / enabled 是**池**的调度参数，只有面板自己用；上游只认地址。
+// 但面板在权重非 100 或停用线路时会写成对象形，上游原来的 map[string]string
+// 解析会直接失败：整份 config.json 读不进来，启动时上游起不来，热重载时也只能
+// 跳过。这里兼容两种写法：对象只取 url，其余键忽略。
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// ProxyTable 线路名 → 地址；JSON 值兼容字符串与 {url,...} 对象。
+type ProxyTable map[string]string
+
+func (t *ProxyTable) UnmarshalJSON(raw []byte) error {
+	var table map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &table); err != nil {
+		return err
+	}
+	out := make(ProxyTable, len(table))
+	for name, value := range table {
+		var text string
+		if err := json.Unmarshal(value, &text); err == nil {
+			out[name] = strings.TrimSpace(text)
+			continue
+		}
+		var obj struct {
+			URL string `json:"url"`
+		}
+		if err := json.Unmarshal(value, &obj); err != nil {
+			return fmt.Errorf("proxies[%s]: %w", name, err)
+		}
+		out[name] = strings.TrimSpace(obj.URL)
+	}
+	*t = out
+	return nil
+}
diff --git a/cmd/server/proxy_reload.go b/cmd/server/proxy_reload.go
new file mode 100644
index 0000000..70612c4
--- /dev/null
+++ b/cmd/server/proxy_reload.go
@@ -0,0 +1,76 @@
+package main
+
+// config.json 的 proxies 段热重载（issue #379）。
+//
+// 面板「设置 → 代理」把线路表写进上游 config.json；上游此前只在启动时
+// ConfigureProxies 一次。于是「加线路 → 点测试（面板发出）→ 请求模型」这条最常见的
+// 操作里，测试是通的、聊天却报错：线路名不在启动快照里，上游按设计明确失败
+// （不静默直连），而错误路径几乎不留日志。重启容器能解决，但每改一次线路都要求
+// 用户记得重启，不该是配置的默认成本。
+//
+// 这里与 sanitize_reload.go 同一套做法：轮询 config.json 的 mtime+size，变了就
+// 重新 Load 并整体替换线路表（ConfigureProxies 幂等，并会清空按线路缓存的连接池，
+// 地址改了不会复用旧代理连接）。解析失败只记 WARN、保留旧表——一次手误不能把
+// 正在服务的出口打空。
+
+import (
+	"log"
+	"os"
+	"time"
+
+	"workbuddy2api/internal/upstream"
+)
+
+// proxyWatchInterval 线路表轮询间隔：面板保存后最多这么久生效。与 auths 热加载
+// （5s）同量级；这段时间旧表仍在服务，不会因为等待热加载而中断在途请求。
+const proxyWatchInterval = 5 * time.Second
+
+// reloadProxyConfig 读一次配置并注入线路表；返回是否成功。
+func reloadProxyConfig(path string) bool {
+	cfg, err := Load(path)
+	if err != nil {
+		log.Printf("WARN: 出口线路表热重载跳过（配置读取失败）：%v", err)
+		return false
+	}
+	upstream.ConfigureProxies(cfg.Proxies)
+	names := upstream.RouteNames()
+	if len(names) > 0 {
+		log.Printf("出口线路表已热重载：%d 条（%v）", len(names), names)
+	} else {
+		log.Printf("出口线路表已热重载：未配置线路（config.json 的 proxies 段）")
+	}
+	return true
+}
+
+// watchProxyConfig 后台轮询配置文件；stop 关闭时退出。
+func watchProxyConfig(path string, stop <-chan struct{}) {
+	if path == "" {
+		return
+	}
+	stamp := func() (int64, int64) {
+		st, err := os.Stat(path)
+		if err != nil {
+			return 0, 0
+		}
+		return st.ModTime().UnixNano(), st.Size()
+	}
+	lastMod, lastSize := stamp()
+	ticker := time.NewTicker(proxyWatchInterval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticker.C:
+			mod, size := stamp()
+			if mod == 0 {
+				continue // 原子替换的间隙：下轮再看
+			}
+			if mod == lastMod && size == lastSize {
+				continue
+			}
+			lastMod, lastSize = mod, size
+			reloadProxyConfig(path)
+		}
+	}
+}
diff --git a/cmd/server/proxy_reload_test.go b/cmd/server/proxy_reload_test.go
new file mode 100644
index 0000000..7496f83
--- /dev/null
+++ b/cmd/server/proxy_reload_test.go
@@ -0,0 +1,85 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"workbuddy2api/internal/upstream"
+)
+
+// issue #379：面板改 config.json 的 proxies 段后，上游不重启也要能解析新线路；
+// 解析失败时保留旧表。
+func TestReloadProxyConfig(t *testing.T) {
+	upstream.ConfigureProxies(nil)
+	t.Cleanup(func() { upstream.ConfigureProxies(nil) })
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.json")
+	write := func(s string) {
+		t.Helper()
+		if err := os.WriteFile(path, []byte(s), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	write(`{"proxies":{"route-a":"socks5h://user:pass@a.example:1080"}}`)
+	if !reloadProxyConfig(path) {
+		t.Fatal("首次热重载失败")
+	}
+	if names := upstream.RouteNames(); len(names) != 1 || names[0] != "route-a" {
+		t.Fatalf("线路表不对：%v", names)
+	}
+	tr, err := upstream.TransportFor("route-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, err := tr.Proxy(&http.Request{URL: &url.URL{Scheme: "https", Host: "api.example"}})
+	if err != nil || u == nil || u.Host != "a.example:1080" {
+		t.Fatalf("route-a 代理不对：%v %v", u, err)
+	}
+
+	// 改地址：必须重建 transport，不能复用旧代理连接池。
+	write(`{"proxies":{"route-a":"http://b.example:8080"}}`)
+	if !reloadProxyConfig(path) {
+		t.Fatal("第二次热重载失败")
+	}
+	tr2, err := upstream.TransportFor("route-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	u2, err := tr2.Proxy(&http.Request{URL: &url.URL{Scheme: "https", Host: "api.example"}})
+	if err != nil || u2 == nil || u2.Host != "b.example:8080" {
+		t.Fatalf("改地址后代理没更新：%v %v", u2, err)
+	}
+
+	// 坏配置：返回失败，旧线路仍在（不能把正在服务的表清空）。
+	write(`{"proxies":`)
+	if reloadProxyConfig(path) {
+		t.Fatal("坏配置应返回 false")
+	}
+	if names := upstream.RouteNames(); len(names) != 1 || names[0] != "route-a" {
+		t.Fatalf("坏配置把旧线路表清空了：%v", names)
+	}
+}
+
+// 面板在权重非 100 / 停用线路时会写对象形；上游必须也能读，否则整份配置解析失败。
+func TestProxyTableAcceptsObjectAndString(t *testing.T) {
+	var cfg struct {
+		Proxies ProxyTable `json:"proxies"`
+	}
+	raw := `{"proxies":{"a":"http://a.example:8080",` +
+		`"b":{"url":"socks5h://user:pass@b.example:1080","weight":30,"enabled":false}}}`
+	if err := json.Unmarshal([]byte(raw), &cfg); err != nil {
+		t.Fatalf("对象形线路表解析失败：%v", err)
+	}
+	if got := cfg.Proxies["a"]; got != "http://a.example:8080" {
+		t.Errorf("字符串形地址不对：%q", got)
+	}
+	if got := cfg.Proxies["b"]; got != "socks5h://user:pass@b.example:1080" {
+		t.Errorf("对象形地址不对：%q", got)
+	}
+}
