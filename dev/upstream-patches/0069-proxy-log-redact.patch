@@ -0,0 +1,17 @@
+package upstream
+
+import "testing"
+
+// TestRedactProxyError 代理地址里的用户/密码不能进日志（2026-11-28 审查）。
+func TestRedactProxyError(t *testing.T) {
+	cases := map[string]string{
+		`proxy address has no host: "http://user:secret@": missing host`: `proxy address has no host: "http://***@": missing host`,
+		`invalid proxy address: parse "socks5://u:p@host:1080": bad`:     `invalid proxy address: parse "socks5://***@host:1080": bad`,
+		`proxy address has no host: "http://host:8080"`:                  `proxy address has no host: "http://host:8080"`,
+	}
+	for in, want := range cases {
+		if got := redactProxyError(in); got != want {
+			t.Errorf("redactProxyError(%q) = %q want %q", in, got, want)
+		}
+	}
+}
