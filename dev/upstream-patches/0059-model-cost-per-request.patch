+// TestModelCostZeroCreditTierRequiresTwo 单笔 credit=0 不判免费（未知，tier 1）；
+// 两笔累计 0 才进 tier 0。行为断言：两笔 0 的号压过单笔 0 的号。
+func TestModelCostZeroCreditTierRequiresTwo(t *testing.T) {
+	p := New("")
