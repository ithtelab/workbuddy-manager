+// legacyCLIUA 强制三段式 CLI UA（`WorkBuddy/<ver> <platform>/<ver> CLI/<cliVer>`）。
+//
+// 只给有 UA 门禁的端点用（`/v3/config`：历史上只有三段式能过，单段/网页 UA 被
+// 400 code 12403 拒）。不受 upstream.ua_style 影响——默认改成桌面单段后，这个端点
+// 仍然必须发 CLI 形态，否则模型目录会静默缺模型（2026-11-28 审查）。
+func (c *Client) legacyCLIUA(a *auth.Auth) string {
+	platform := "WorkBuddy"
+	if a != nil && a.IsGlobal() {
+		platform = "WorkBuddy AI"
+	}
+	return "WorkBuddy/" + c.clientVersion() + " " + platform + "/" + c.clientVersion() + " CLI/" + c.cliVersion()
+}
