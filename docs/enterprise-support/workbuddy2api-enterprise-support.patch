diff --git a/internal/scheduler/scheduler.go b/internal/scheduler/scheduler.go
index 55d2dca..00e65f9 100644
--- a/internal/scheduler/scheduler.go
+++ b/internal/scheduler/scheduler.go
@@ -433,6 +433,57 @@ func (s *Scheduler) runCheckinNow(ctx context.Context) {
 //
 // session dead 走 Pool.NoteSessionDead 的**连续计数**语义（与 keepalive 一致）：
 // 一次刷新失败不再立即杀号，连续 sessionDeadThreshold 次才禁用，刷新成功清计数。
+
+// BalanceOutcome 单个账号的余额刷新结果（供 POST /v1/balance/refresh 回执）。
+type BalanceOutcome struct {
+	UID      string `json:"uid"`
+	Nickname string `json:"nickname,omitempty"`
+	Credits  *int64 `json:"credits,omitempty"`
+	Expiring *int64 `json:"expiring,omitempty"`
+	Error    string `json:"error,omitempty"`
+}
+
+// RefreshBalances 对全池账号执行一次余额刷新（**不签到、不改 token**）。
+//
+// 为什么需要这个入口：上游的 credits 只在签到定时任务（checkin_hours，默认
+// 9/21 点）里刷新，而 /status 与面板读的是那个快照 —— 两次签到之间余额变化
+// 反映不到界面（企业账号的周期额度尤其明显：周期内消耗变化不会自己出现）。
+// 手动触发一次刷新即可让状态与上游真实值对齐。
+//
+// 与 checkinAll 的差异：只查余额，不发起签到。企业账号签不了（400 code=10001），
+// 个人账号签到有副作用，两者都不该被"刷新余额"连带触发。
+// 企业账号的额度由 UserResourceDetailed 内的企业分支处理
+// （remain = limitNum - credit，见 upstream/enterprise_usage.go）。
+func (s *Scheduler) RefreshBalances() []BalanceOutcome {
+	statuses := s.cfg.Pool.List()
+	out := make([]BalanceOutcome, 0, len(statuses))
+	for _, st := range statuses {
+		if st.Disabled {
+			continue
+		}
+		a := s.cfg.Pool.AuthByUID(st.UID)
+		if a == nil || a.RefreshTokenValue() == "" {
+			continue
+		}
+		oc := BalanceOutcome{UID: st.UID, Nickname: st.Nickname}
+		remain, buckets, err := s.cfg.Upstream.UserResourceDetailed(a, s.cfg.ExpiringSoonWindow)
+		if err != nil {
+			oc.Error = err.Error()
+			log.Printf("balance-refresh %s: %v", logfmt.Label(st.UID, st.Nickname), err)
+			out = append(out, oc)
+			continue
+		}
+		// 写回池状态：与签到路径同口径，保证 /status 与选号用的都是新值。
+		s.cfg.Pool.SetCreditsDetailed(st.UID, remain, buckets.Expiring)
+		r := remain
+		oc.Credits = &r
+		e := buckets.Expiring
+		oc.Expiring = &e
+		out = append(out, oc)
+	}
+	return out
+}
+
 func (s *Scheduler) CheckinAll() ([]CheckinOutcome, error) {
 	return s.checkinAll(context.Background())
 }
