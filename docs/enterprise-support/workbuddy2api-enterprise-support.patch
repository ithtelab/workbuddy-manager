@@ -1336,3 +1352,29 @@ func (h *Handler) hintOf(kind upstream.ErrKind, body, bareModel string, hasImage
 	}
 	return upstream.GatewayHint(kind, msg, h.hintContext(bareModel, hasImage))
 }
+
+
+// balanceRefresh 手动触发一次全池余额刷新（POST /v1/balance/refresh）。
+//
+// 上游 credits 只在签到定时任务里刷新，两次签到之间 /status 的余额是旧值。
+// 本端点复用 scheduler.RefreshBalances()：只查余额、不签到、不改 token。
+func (h *Handler) balanceRefresh(w http.ResponseWriter, r *http.Request) {
+	if h.cfg.Scheduler == nil {
+		writeJSON(w, http.StatusServiceUnavailable, map[string]any{
+			"error": map[string]any{"message": "余额刷新未启用", "type": "api_error"},
+		})
+		return
+	}
+	outcomes := h.cfg.Scheduler.RefreshBalances()
+	okN := 0
+	for _, oc := range outcomes {
+		if oc.Error == "" {
+			okN++
+		}
+	}
+	writeJSON(w, http.StatusOK, map[string]any{
+		"total":     len(outcomes),
+		"succeeded": okN,
+		"accounts":  outcomes,
+	})
+}
